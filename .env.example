# ================= AI 模型平台（OpenAI 兼容接口）=================
# 必填：你的 API Key（下面是无效占位符，请替换成你自己平台后台生成的 Key）
AI_API_KEY=sk-your-api-key-here

# 模型平台的接口地址（OpenAI 兼容 /chat/completions 基础路径）
# 智谱开放平台（默认）: https://open.bigmodel.cn/api/paas/v4
# DeepSeek:            https://api.deepseek.com/v1
# Moonshot Kimi:       https://api.moonshot.cn/v1
# 阿里云百炼通义:       https://dashscope.aliyuncs.com/compatible-mode/v1
# SiliconFlow 硅基流动: https://api.siliconflow.cn/v1
# OpenRouter:          https://openrouter.ai/api/v1
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 模型名称（以平台文档为准，例如 glm-4-flash 为智谱的免费模型）
AI_MODEL=glm-4-flash

# ================= 服务 =================
# Web 服务端口
PORT=3000

# 访问密码：设置后打开网页需要先输入密码（建议公网/局域网部署时必填，仅本机使用可留空）
APP_PASSWORD=

# 数据保存目录（SQLite 数据库与上传文件都放在这里）
DATA_DIR=./data

# ================= 高级选项（保持默认即可）=================
# 单个上传文件的大小上限（MB）
UPLOAD_MAX_MB=20
# 调用模型的超时时间（毫秒）
AI_TIMEOUT_MS=60000
# 模型调用失败后的自动重试次数
AI_MAX_RETRIES=1
# 相同输入的结果缓存时长（小时，0 表示关闭缓存）
AI_CACHE_HOURS=168
# 问答时检索的资料片段数量
RAG_TOP_K=6

# ================= 扫描版 PDF 的 OCR 识别 =================
# 是否开启 OCR（0 关闭后，扫描版 PDF 会明确报错而不是识别）
OCR_ENABLED=1
# 识别语言（默认中英混合；首次识别需联网下载语言包，之后缓存在 data/ocr-cache 离线可用）
OCR_LANG=chi_sim+eng
# 每个文件最多 OCR 识别的页数（防止超长扫描件占用太久）
OCR_MAX_PAGES=10
# 页面渲染倍率（越大越清晰、越慢，1-4）
OCR_SCALE=2
# 可选：自定义语言包下载目录/地址（默认自动尝试官方源和镜像）
# OCR_LANG_PATH=
